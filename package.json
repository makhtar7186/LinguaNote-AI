{
  "name": "linguanote-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "dev:web": "npm run dev:web --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "test": "npm run test --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspace apps/desktop",
    "lint": "npm run lint --workspace apps/desktop",
    "smoke": "npm run smoke --workspace apps/desktop",
    "smoke:packaged": "npm run smoke:packaged --workspace apps/desktop",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  }
}

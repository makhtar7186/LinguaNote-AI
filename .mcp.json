{
  "mcpServers": {
    "linguanote": {
      "command": "services/transcription/.venv/Scripts/python.exe",
      "args": ["services/transcription/app/mcp_server.py"],
      "env": {
        "LINGUANOTE_API_URL": "http://127.0.0.1:8765"
      }
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.83"]
    }
  }
}

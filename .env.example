# Reference list of supported environment variables. Every value has a default EXCEPT the API token,
# which is required (see LINGUANOTE_API_TOKEN below) unless Electron starts the service for you.
# The application does NOT load a .env file by itself: export these variables in the shell that starts
# the service / Electron (PowerShell: $env:LINGUANOTE_API_TOKEN = "..."). Never put real secrets in this file.

# --- Backend (services/transcription), read at startup ---
# faster-whisper (default), language-routing (opt-in, files only, see below) or omnilingual-ctc (experimental, not usable on Windows)
LINGUANOTE_ASR_ENGINE=faster-whisper
# language-routing: cuts a file at each language change and sends Wolof passages to a Wolof model, the rest to
# LINGUANOTE_WHISPER_MODEL. All three are required for this engine; nothing is downloaded for the two paths.
# Not available for live transcription (the live socket refuses it with a clear message).
# LINGUANOTE_ROUTING_WOLOF_MODEL=C:\path\to\kiriku-wolof-ct2   (CTranslate2 directory containing model.bin)
# LINGUANOTE_ROUTING_CLASSIFIER=C:\path\to\classifier-tiny.json  (written by scripts/train_language_classifier.py)
# LINGUANOTE_ROUTING_LIVE_WOLOF_MODEL=C:\path\to\lighter-wolof-ct2  (optional: Wolof model used for live; default is the file one)
# Alternative detector with no classifier file: "fr-en-else-wolof" = French or English when Whisper is confident
# it hears one of them (confidence >= threshold), Wolof otherwise. Default: classifier. Re-measure on your own audio.
# LINGUANOTE_ROUTING_DETECTOR=classifier
# LINGUANOTE_ROUTING_RULE_THRESHOLD=0.77
# Whisper size that reads the language of each 3 s window (default tiny; downloaded on first use like any Whisper model)
# LINGUANOTE_ROUTING_LID_MODEL=tiny
# Whisper model name. Weights are downloaded from Hugging Face on the first transcription.
LINGUANOTE_WHISPER_MODEL=base
LINGUANOTE_CPU_THREADS=4
# Where the opt-in history (history.sqlite3) is stored. Nothing is written there unless the user turns the history on.
# Electron sets it to %APPDATA%\@linguanote\desktop\data when it starts the service; default otherwise: <repo>/data (ignored by Git).
# LINGUANOTE_DATA_DIR=C:\Users\you\AppData\Roaming\linguanote-data
# Limits
LINGUANOTE_MAX_UPLOAD_MIB=50
LINGUANOTE_MAX_AUDIO_SECONDS=600
LINGUANOTE_FFMPEG_TIMEOUT_SECONDS=120
# Full path to ffmpeg.exe when it is not in PATH
# LINGUANOTE_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
# Comma-separated browser origins allowed by CORS (only needed for `npm run dev:web`)
LINGUANOTE_CORS_ORIGINS=http://127.0.0.1:5173
# Per-request timeout of one inference. A running inference cannot be interrupted; it is detached.
LINGUANOTE_INFERENCE_TIMEOUT_SECONDS=840
# Transcriptions accepted at once (running + waiting). Beyond this the service answers 429 "busy".
LINGUANOTE_MAX_PENDING=3
# Shared secret, REQUIRED (16+ characters): the service refuses to start without it. Every request must
# send it in X-LinguaNote-Token. Electron generates one per launch when it starts the service itself;
# set it by hand only when running the service separately. Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# LINGUANOTE_API_TOKEN=
# Development only: run without authentication (any local process or web page can then drive the API).
# LINGUANOTE_ALLOW_NO_AUTH=1
# Logs (default: data/logs, git-ignored). Logs never contain audio or transcript text.
# LINGUANOTE_LOG_DIR=
LINGUANOTE_LOG_LEVEL=INFO

# --- Desktop (Electron main process) ---
# By default Electron starts the service itself (free port, ephemeral token).
# Python used to start it (default: services/transcription/.venv)
# LINGUANOTE_PYTHON=
# Use a backend you run yourself instead (must be an http loopback address; LINGUANOTE_API_TOKEN must match).
# LINGUANOTE_API_URL=http://127.0.0.1:8765
# Browser preview only (`npm run dev:web`): backend URL and token used by the renderer.
# VITE_TRANSCRIPTION_API=http://127.0.0.1:8765
# VITE_TRANSCRIPTION_TOKEN=

# --- MCP bridge (services/transcription/app/mcp_server.py) ---
# Remote backends are refused unless this is 1 AND LINGUANOTE_API_URL is https.
# LINGUANOTE_ALLOW_REMOTE_API=1

# --- Live transcription (WebSocket /api/v1/live) ---
# Hard cap on one session, seconds of audio received.
LINGUANOTE_LIVE_MAX_SECONDS=3600
# A session with no audio frame and no ping for this long is ended (idle_timeout).
LINGUANOTE_LIVE_IDLE_SECONDS=30
# A session whose connection dropped is kept this long so the client can resume it.
LINGUANOTE_LIVE_RESUME_SECONDS=30
# One utterance taking longer than this to transcribe is skipped, with an explicit error.
LINGUANOTE_LIVE_JOB_TIMEOUT_SECONDS=60

# --- Floating bubble: global shortcuts (Electron accelerators). An empty value disables that shortcut. ---
# LINGUANOTE_SHORTCUT_TOGGLE_LIVE=CommandOrControl+Alt+D
# LINGUANOTE_SHORTCUT_PAUSE_LIVE=CommandOrControl+Alt+P
# LINGUANOTE_SHORTCUT_TOGGLE_BUBBLE=CommandOrControl+Alt+B
# Smoke test only (npm run smoke): allow fetching the model if it is not cached. Off by default.
# LINGUANOTE_SMOKE_ALLOW_DOWNLOAD=1
# Smoke test only: also run the AUDIBLE scenario (the computer speaks one sentence, captured as computer sound).
# LINGUANOTE_SMOKE_SYSTEM_AUDIO=1

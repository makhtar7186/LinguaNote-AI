# Reference list of supported environment variables. Nothing here is required: every value has a default.
# The application does NOT load a .env file by itself: export these variables in the shell that starts
# the service / Electron (PowerShell: $env:LINGUANOTE_API_TOKEN = "..."). Never put real secrets in this file.

# --- Backend (services/transcription), read at startup ---
# faster-whisper (default) or omnilingual-ctc (experimental, not usable on Windows)
LINGUANOTE_ASR_ENGINE=faster-whisper
# Whisper model name. Weights are downloaded from Hugging Face on the first transcription.
LINGUANOTE_WHISPER_MODEL=base
LINGUANOTE_CPU_THREADS=4
# Limits
LINGUANOTE_MAX_UPLOAD_MIB=50
LINGUANOTE_MAX_AUDIO_SECONDS=600
LINGUANOTE_FFMPEG_TIMEOUT_SECONDS=120
# Full path to ffmpeg.exe when it is not in PATH
# LINGUANOTE_FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
# Comma-separated browser origins allowed by CORS (only needed for `npm run dev:web`)
LINGUANOTE_CORS_ORIGINS=http://127.0.0.1:5173
# Per-request timeout of one inference. A running inference cannot be interrupted; it is detached.
LINGUANOTE_INFERENCE_TIMEOUT_SECONDS=840
# Shared secret, REQUIRED (16+ characters): the service refuses to start without it. Every request must
# send it in X-LinguaNote-Token. Electron generates one per launch when it starts the service itself;
# set it by hand only when running the service separately. Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# LINGUANOTE_API_TOKEN=
# Development only: run without authentication (any local process or web page can then drive the API).
# LINGUANOTE_ALLOW_NO_AUTH=1
# Logs (default: data/logs, git-ignored). Logs never contain audio or transcript text.
# LINGUANOTE_LOG_DIR=
LINGUANOTE_LOG_LEVEL=INFO

# --- Desktop (Electron main process) ---
# By default Electron starts the service itself (free port, ephemeral token).
# Python used to start it (default: services/transcription/.venv)
# LINGUANOTE_PYTHON=
# Use a backend you run yourself instead (must be an http loopback address; LINGUANOTE_API_TOKEN must match).
# LINGUANOTE_API_URL=http://127.0.0.1:8765
# Browser preview only (`npm run dev:web`): backend URL and token used by the renderer.
# VITE_TRANSCRIPTION_API=http://127.0.0.1:8765
# VITE_TRANSCRIPTION_TOKEN=

# --- MCP bridge (services/transcription/app/mcp_server.py) ---
# Remote backends are refused unless this is 1 AND LINGUANOTE_API_URL is https.
# LINGUANOTE_ALLOW_REMOTE_API=1
